class Solution {
    public int[] findDiagonalOrder(int[][] mat) {

        int rows = mat.length;
        int cols = mat[0].length;

        int[] result = new int[rows * cols];

        int row = 0;
        int col = 0;
        int direction = 1;

        for (int i = 0; i < rows * cols; i++) {

            result[i] = mat[row][col];

            if (direction == 1) {
                // Moving up-right
                if (col == cols - 1) {
                    row++;
                    direction = -1;
                } 
                else if (row == 0) {
                    col++;
                    direction = -1;
                } 
                else {
                    row--;
                    col++;
                }

            } else {
                // Moving down-left
                if (row == rows - 1) {
                    col++;
                    direction = 1;
                } 
                else if (col == 0) {
                    row++;
                    direction = 1;
                } 
                else {
                    row++;
                    col--;
                }
            }
        }

        return result;
    }
}